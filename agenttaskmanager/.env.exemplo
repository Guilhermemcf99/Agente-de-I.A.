# Copie este arquivo para .env (na mesma pasta) e preencha com as suas chaves.
# NUNCA versione o arquivo .env.

# Gemini (chave gratuita em https://aistudio.google.com/apikey)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=cole_aqui_sua_chave_do_gemini
GEMINI_MODEL=gemini-2.5-flash

# Trello (portal de Power-Ups: https://trello.com/power-ups/admin/)
TRELLO_API_KEY=cole_aqui_sua_api_key
TRELLO_API_SECRET=cole_aqui_seu_segredo
TRELLO_TOKEN=cole_aqui_seu_token

# Nome do quadro que o agente usa e fuso horário das datas
TRELLO_BOARD_NAME=DIO
TIMEZONE=America/Sao_Paulo
